{
  "name": "dsh-prompt-translation",
  "version": "0.1.2",
  "description": "Prompt, reasoning and response translation for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "dsh-plugin.naming.json",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "dshCompatibility": {
    "0.2.0-rc.1": { "cordis": "4.0.4" },
    "0.2.0-rc.2": { "cordis": "4.0.4" },
    "0.2.1-rc.1": { "cordis": "4.0.5" },
    "0.2.1-rc.2": { "cordis": "4.0.5" },
    "0.2.1-rc.3": { "cordis": "4.0.5" },
    "0.2.1-rc.4": { "cordis": "4.0.5" }
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run tests",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "pack:check": "node scripts/package-artifact.mjs",
    "host:install": "node scripts/install-host.mjs",
    "test:host": "node scripts/full-host-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run test:scripts && npm run pack:check"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.1 <0.2.0 || >=0.2.1-rc.1 <0.2.1",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1 <0.2.0 || >=0.2.1-rc.1 <0.2.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.1 <0.2.0 || >=0.2.1-rc.1 <0.2.1",
    "@deepseek-ai/dsh-typert-registry": ">=0.2.0-rc.1 <0.2.0 || >=0.2.1-rc.1 <0.2.1",
    "@deepseek-ai/schemastery": "^3.18.4",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.4",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.4",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.4",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.4",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.28.0",
    "jsdom": "^27.0.0",
    "playwright-core": "^1.61.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "7.7.2",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "author": "Fla1337",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EPCN-fla/dsh-prompt-translation.git"
  },
  "bugs": {
    "url": "https://github.com/EPCN-fla/dsh-prompt-translation/issues"
  },
  "homepage": "https://github.com/EPCN-fla/dsh-prompt-translation#readme",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "translation",
    "prompt-translation"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.4.3"
  }
}
